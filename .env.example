# Настройки приложения
PROJECT_NAME="Афиша культуры Башкортостана"
ENVIRONMENT="production"
DEBUG=false
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL="http://localhost:8000"

# База данных PostgreSQL (для Docker Compose)
POSTGRES_DB=afisha_db
POSTGRES_USER=afisha_user
POSTGRES_PASSWORD=afisha_password
DATABASE_URL=postgresql+asyncpg://afisha_user:afisha_password@db:5432/afisha_db
DATABASE_URL_SYNC=postgresql+psycopg://afisha_user:afisha_password@db:5432/afisha_db

# Для локальной разработки без Docker (раскомментируйте при необходимости):
# DATABASE_URL=sqlite+aiosqlite:///./afisha.db

# Админ-панель (Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=culture_bashkortostan_2026

# Безопасность и лимиты
RATE_LIMIT_PER_MINUTE=60
FEEDBACK_RATE_LIMIT_PER_MINUTE=3
SUBSCRIPTION_RETENTION_DAYS=180

# Telegram-бот
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Для Docker: http://web:8000/api/v1; для локального запуска без Docker: http://localhost:8000/api/v1
BACKEND_API_URL=http://web:8000/api/v1
